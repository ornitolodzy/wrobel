# copy to .env, don't commit .env

LOG_LEVEL=INFO
# swagger at /docs, set false in production (only the gateway should be public)
DOCS_ENABLED=true

# postgres, docker compose builds DATABASE_URL from these
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=scraper
# only for running without docker
DATABASE_URL=postgresql+asyncpg://scraper:change-me-db@127.0.0.1:5433/scraper

# list of sources
SOURCES_FILE=sources.yaml

# how we fetch pages
USER_AGENT=Mozilla/5.0 (compatible; FactCheckBot/0.1)
REQUEST_TIMEOUT_SECONDS=15
MAX_PAGE_BYTES=5000000
CRAWL_DELAY_SECONDS=0.5

# headless browser for js pages
RENDER_ENABLED=true
RENDER_TIMEOUT_SECONDS=30
MAX_CONCURRENT_RENDERS=2
# below this many chars we try the browser
MIN_TEXT_CHARS=200

# automatic scraping every N minutes, 0 = only by hand (POST /scrap/all)
SCRAPE_INTERVAL_MINUTES=360
# also run once right after start
SCRAPE_ON_STARTUP=false
# retry once after a network error
RETRY_DELAY_SECONDS=1.5

# google fact check api key, empty = source skipped
GOOGLE_FACTCHECK_API_KEY=
# euvsdisinfo database token (ask the organizer), empty = source skipped
EUVSDISINFO_TOKEN=
# folder with json/csv files to import (incident database)
IMPORTS_DIR=imports

# where to send new documents (RAG service), empty = don't send
RAG_INGEST_URL=
