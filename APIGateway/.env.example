# copy to .env, don't commit .env

APP_ENV=dev
LOG_LEVEL=INFO

# admin key, empty = admin endpoints off
ADMIN_API_KEY=change-me-admin
# channels from X-Channel header, anything else = unknown
ALLOWED_CHANNELS=web,discord
# proxy ip (caddy), in docker e.g. 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1
# frontend urls
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# limits
RATE_LIMIT_PER_MINUTE=30
MAX_TEXT_LENGTH=5000
MAX_URL_LENGTH=2048
MAX_IMAGE_SIZE_MB=10

# postgres, docker compose builds DATABASE_URL from these
POSTGRES_USER=prawdowid
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=prawdowid
# only for running without docker
DATABASE_URL=postgresql+asyncpg://prawdowid:change-me-db@127.0.0.1:5432/prawdowid
RETENTION_DAYS=30

# services, empty = mock
LLM_SERVICE_URL=
PAGE_SCRAPPER_URL=
IMAGE_RECOGNITION_URL=
DOWNSTREAM_TIMEOUT_SECONDS=30

# everything on mock
MOCK_MODE=false

# defaults, can be changed with PATCH /api/v1/config
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
DEFAULT_LANGUAGE=pl
DEFAULT_MAX_CLAIMS=3
DEFAULT_MAX_SOURCES=5
