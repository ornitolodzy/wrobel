# Skopiuj do .env (obok docker-compose.yml). Nie commituj .env.
# Wszystko jest opcjonalne: bez kluczy stack działa, ale pipeline nie ocenia stanowiska źródeł
# (każde twierdzenie kończy się werdyktem "brak dowodów").

# --- Model LLM dla VerificationPipeline (wszystkie role: claims, stance, compose) ---
# Pusty provider = konfiguracja z VerificationPipeline/conf (provider mock, reguły, bez sieci).
PRAWDOWID_LLM_PROVIDER=
PRAWDOWID_LLM_MODEL=
# Przykłady:
#   PRAWDOWID_LLM_PROVIDER=litellm  PRAWDOWID_LLM_MODEL=anthropic/claude-opus-5-5
#   PRAWDOWID_LLM_PROVIDER=litellm  PRAWDOWID_LLM_MODEL=mistral/mistral-large-latest
#   Bielik (vLLM, OpenAI API): PRAWDOWID_LLM_MODEL=openai/speakleash/Bielik-11B-v2.3-Instruct
#                              PRAWDOWID_LLM_API_BASE=http://host.docker.internal:8001/v1
PRAWDOWID_LLM_API_BASE=

ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- PageScrapper: dodatkowe źródła (bez kluczy są pomijane) ---
GOOGLE_FACTCHECK_API_KEY=
EUVSDISINFO_TOKEN=
