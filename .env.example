# Skopiuj do .env (obok docker-compose.yml). Nie commituj .env.
# Wszystko jest opcjonalne: bez kluczy stack działa, ale pipeline nie ocenia stanowiska źródeł
# (każde twierdzenie kończy się werdyktem "brak dowodów").

# --- Model LLM dla VerificationPipeline (wszystkie role: claims, stance, compose) ---
# Pusty provider = konfiguracja z VerificationPipeline/conf (provider mock, reguły, bez sieci).
PRAWDOWID_LLM_PROVIDER=
PRAWDOWID_LLM_MODEL=
# Przykłady:
#   PRAWDOWID_LLM_PROVIDER=litellm  PRAWDOWID_LLM_MODEL=anthropic/claude-opus-5-5
#   PRAWDOWID_LLM_PROVIDER=litellm  PRAWDOWID_LLM_MODEL=mistral/mistral-large-latest
#   Bielik (vLLM, OpenAI API): PRAWDOWID_LLM_MODEL=openai/speakleash/Bielik-11B-v2.3-Instruct
#                              PRAWDOWID_LLM_API_BASE=http://host.docker.internal:8001/v1
PRAWDOWID_LLM_API_BASE=

# Bielik przez tunel SSH (patrz niżej): Ollama -> PRAWDOWID_LLM_MODEL=ollama/bielik,
#   PRAWDOWID_LLM_API_BASE=http://host.docker.internal:11435 ; vLLM -> port 8011 + /v1, OPENAI_API_KEY=none

# --- Embeddingi i reranker (VerificationPipeline) ---
# Puste = mock (wektory z hashy słów, bez sieci). Prawdziwe: bge-m3 na Ollamie (serwer z Bielikiem).
# Tunel na hoście, związany z mostkiem Dockera, żeby kontener go widział:
#   ssh -N -L 172.17.0.1:11435:localhost:11434 <user>@<serwer>
PRAWDOWID_EMBEDDINGS_PROVIDER=
PRAWDOWID_EMBEDDINGS_MODEL=
#   np. ollama / bge-m3 / http://host.docker.internal:11435
PRAWDOWID_EMBEDDINGS_API_BASE=
# Reranker bge-reranker-v2-m3. Dwie opcje:
#  - remote (zalecane): GPU na serwerze z Bielikiem, VerificationPipeline/deploy/rerank-server/README.md;
#    tunel: -L 172.17.0.1:8081:127.0.0.1:8081 ; ~0,3 s zamiast ~12 s na sprawdzenie
#  - local: CPU w kontenerze (~2 GB RAM), obraz z WITH_RERANK=true
# fallback=local przełącza na CPU, gdy serwer nie odpowiada (wymaga WITH_RERANK=true).
WITH_RERANK=false
PRAWDOWID_RERANKER_ENABLED=
PRAWDOWID_RERANKER_PROVIDER=
#   np. remote / http://host.docker.internal:8081 / local
PRAWDOWID_RERANKER_API_BASE=
PRAWDOWID_RERANKER_FALLBACK=

ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- PageScrapper: dodatkowe źródła (bez kluczy są pomijane) ---
GOOGLE_FACTCHECK_API_KEY=
EUVSDISINFO_TOKEN=
