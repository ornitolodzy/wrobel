NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextgraph
NEO4J_DATABASE=neo4j
CHUNK_MAX_CHARS=600
SEED_LIMIT=20

# Embeddingi: ten sam model co w VerificationPipeline (bge-m3, 1024). none = zapis bez wektorów,
# potem POST /embeddings/backfill. ollama = serwer z Bielikiem przez tunel SSH.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_API_BASE=http://127.0.0.1:11435

# Warstwa 2 (zdarzenia): endpoint zgodny z OpenAI (Bielik na vLLM albo Ollama /v1). none = wyłączone.
EVENTS_PROVIDER=none
EVENTS_MODEL=bielik
EVENTS_API_BASE=http://127.0.0.1:11435/v1
EVENTS_API_KEY=
