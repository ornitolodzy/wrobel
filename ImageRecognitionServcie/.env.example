# Skopiuj do .env i dostosuj. Wszystkie zmienne są opcjonalne - poniżej wartości domyślne.

# --- Serwer HTTP ---
OCR_HOST=0.0.0.0
OCR_PORT=8000
# DEBUG | INFO | WARNING | ERROR
OCR_LOG_LEVEL=INFO
# true = logi JSON (produkcja), false = czytelne logi tekstowe (lokalnie)
OCR_LOG_JSON=true

# --- Silnik OCR ---
OCR_ENGINE=paddleocr
# Języki obsługiwane przez instancję (i domyślne dla żądań bez parametru langs)
OCR_LANGS=pl,en
# Liczba instancji silnika = ile obrazów jest OCR-owanych równolegle (każda zajmuje RAM)
OCR_WORKERS=1
# Ile żądań może czekać na wolny silnik, zanim kolejne dostaną 503 busy
OCR_MAX_QUEUE=16
# Maksymalny czas oczekiwania na wolny silnik (s), potem 503 queue_timeout
OCR_QUEUE_TIMEOUT_S=30

# --- Limity wejścia ---
# Maksymalny rozmiar pliku obrazu w bajtach (10 MiB)
OCR_MAX_FILE_BYTES=10485760
# Maksymalna liczba pikseli (szer. x wys.) - ochrona przed decompression bomb
OCR_MAX_PIXELS=40000000

# --- Bezpieczeństwo ---
# Gdy ustawiony, /v1/* wymaga nagłówka X-API-Key o tej wartości. Puste = wyłączone.
OCR_API_KEY=

# --- Preprocessing ---
# Obrazy, których dłuższy bok jest mniejszy, są powiększane (0 = wyłączone)
OCR_PREPROCESS_UPSCALE_TARGET=1280
# Maksymalny współczynnik powiększenia
OCR_PREPROCESS_MAX_UPSCALE=3.0
# Wykrywanie ciemnego motywu i inwersja kolorów
OCR_PREPROCESS_DARK_MODE=true
# Mediana jasności (0-255), poniżej której obraz uznajemy za ciemny
OCR_PREPROCESS_DARK_THRESHOLD=110

# --- Modele / PaddleOCR ---
# Katalog na wagi modeli (pusty = ~/.paddlex). W Dockerze: /opt/models
OCR_MODEL_DIR=./models
# true = nie sprawdzaj hostingu modeli przy starcie (wagi muszą już być w OCR_MODEL_DIR)
OCR_OFFLINE=false
OCR_PADDLE_DET_MODEL=PP-OCRv5_mobile_det
OCR_PADDLE_REC_MODEL=latin_PP-OCRv5_mobile_rec
# cpu | gpu:0
OCR_PADDLE_DEVICE=cpu
OCR_PADDLE_CPU_THREADS=4
# auto (włączone poza Windows) | true | false
OCR_PADDLE_ENABLE_MKLDNN=auto
# Bloki z pewnością poniżej progu są odrzucane
OCR_PADDLE_MIN_SCORE=0.5
