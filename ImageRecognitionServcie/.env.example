# Copy to .env and adjust. Every variable is optional - the values below are the defaults.

# --- HTTP server ---
OCR_HOST=0.0.0.0
OCR_PORT=8000
# DEBUG | INFO | WARNING | ERROR
OCR_LOG_LEVEL=INFO
# true = JSON logs (production), false = human-readable text logs (local)
OCR_LOG_JSON=true

# --- OCR engine ---
OCR_ENGINE=paddleocr
# Languages served by this instance (and the default for requests without `langs`)
OCR_LANGS=pl,en
# process = every worker is a separate process with its own model (scales across all cores,
#           crashed/hung workers are restarted) - recommended
# thread  = workers are threads of the API process (debugging; limited by the GIL)
OCR_EXECUTOR=process
# Number of workers = how many images are OCR-ed in parallel.
# 0 = auto: available CPUs (container limit aware) / OCR_PADDLE_CPU_THREADS, capped by memory
OCR_WORKERS=0
# RAM budget per worker (MB) used when OCR_WORKERS=0
OCR_WORKER_MEMORY_MB=700
# How many requests may wait for a free worker before new ones get 503 busy
OCR_MAX_QUEUE=64
# Max wait for a free worker (s), then 503 queue_timeout
OCR_QUEUE_TIMEOUT_S=30
# Max OCR time per image (s); a hung worker is killed and restarted (504)
OCR_TASK_TIMEOUT_S=120

# Minimum recognition confidence (0-1) for a text block to be reported at all;
# blocks below it are treated as "no text there"
OCR_MIN_CONFIDENCE=0.5

# --- Result delivery (callback mode) ---
# When set, POST /v1/ocr answers 202 {request_id} immediately and the OCR result is POSTed
# as JSON to this URL. Empty = synchronous mode (result returned in the HTTP response).
OCR_CALLBACK_URL=
# Optional token sent to the receiver as "Authorization: Bearer <token>"
OCR_CALLBACK_TOKEN=
# Timeout of a single delivery attempt (s)
OCR_CALLBACK_TIMEOUT_S=10
# Retries on network errors, 5xx and 429 (other 4xx are not retried)
OCR_CALLBACK_RETRIES=3
# First retry delay (s); doubles on every further retry
OCR_CALLBACK_RETRY_BACKOFF_S=1.0

# --- Input limits ---
# Max image file size in bytes (10 MiB)
OCR_MAX_FILE_BYTES=10485760
# Max pixel count (width x height) - decompression bomb protection
OCR_MAX_PIXELS=40000000

# --- Security ---
# When set, /v1/* requires an X-API-Key header with this value. Empty = disabled.
OCR_API_KEY=
# Browser origins allowed to call the API (CORS), e.g. * for the test page. Empty = disabled.
OCR_CORS_ORIGINS=

# --- Preprocessing ---
# Images whose longer side is below this are upscaled (0 = disabled)
OCR_PREPROCESS_UPSCALE_TARGET=1280
# Max upscale factor
OCR_PREPROCESS_MAX_UPSCALE=3.0
# Detect dark themes and invert colours
OCR_PREPROCESS_DARK_MODE=true
# Median brightness (0-255) below which an image counts as dark
OCR_PREPROCESS_DARK_THRESHOLD=110

# --- Models / PaddleOCR ---
# Model weights directory (empty = ~/.paddlex). In Docker: /opt/models
OCR_MODEL_DIR=./models
# true = skip the model-hoster check at start-up (weights must already be in OCR_MODEL_DIR)
OCR_OFFLINE=false
OCR_PADDLE_DET_MODEL=PP-OCRv5_mobile_det
OCR_PADDLE_REC_MODEL=latin_PP-OCRv5_mobile_rec
# cpu | gpu:0
OCR_PADDLE_DEVICE=cpu
# Threads per worker. 1 = best throughput under load (one worker per core);
# more = lower latency for a single request when traffic is low
OCR_PADDLE_CPU_THREADS=1
# auto (enabled except on Windows) | true | false
OCR_PADDLE_ENABLE_MKLDNN=auto
