terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Stan lokalny (deploy/aws/terraform/terraform.tfstate, w .gitignore): jedna osoba robi apply.
  # Zawiera wygenerowane hasła, więc nie commituj go i nie wysyłaj nikomu.
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = var.project
      ManagedBy = "terraform"
    }
  }
}
